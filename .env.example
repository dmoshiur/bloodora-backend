# ============================ BloodOra backend environment ============================
# NEVER put any of these values in the frontend repo. The frontend only ever talks
# to the public API origin and never sees Turso tokens, secrets or DB credentials.

# ---- Database (Turso / libSQL) — REQUIRED in production ----
# Remote URL:  libsql://bloodora.xxxxx.eu-central-1.aws.data.turso.io
# Local dev:   leave unset (uses ./data/local.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Auth ----
# Long random string (e.g. `openssl rand -hex 32`). REQUIRED in production.
JWT_SECRET=change-me-64-hex
# 7 = days
JWT_TTL_DAYS=7
COOKIE_DOMAIN=
# Secure cookies are forced on when NODE_ENV=production or COOKIE_SECURE=1.
COOKIE_SECURE=

# ---- CORS / frontend ----
# Comma-separated allow-list of frontend origins, e.g.
# https://lspk.vercel.app,https://lspk-production.vercel.app
# Every listed origin may call the API with credentials. The FIRST one is also
# used as the base for links inside outgoing mail (password reset, email
# verification) — put the canonical public origin first.
FRONTEND_URL=http://localhost:3000

# ---- Environment ----
NODE_ENV=development
PORT=4000
# `info` in production: request/response lines, the budget clamp report and every
# dependency failure are logged at INFO or WARN. At `warn` or above you lose the
# per-request lines entirely, which is why an outage could look like a backend
# that logged "[BOOT] database: ready" and then nothing at all.
LOG_LEVEL=info

# ---- The platform budget (read this before touching any deadline below) ----
# A Vercel function invocation is killed at `maxDuration`, pinned to 10 in
# vercel.json. FUNCTION_MAX_DURATION_MS must always mirror that value.
#
#   budget = FUNCTION_MAX_DURATION_MS - RESPONSE_RESERVE_MS
#
# Every deadline below is CLAMPED to that budget at boot (and the clamp is logged
# at warn level), because a deadline longer than the invocation is not a deadline:
# the platform reaches it first and answers with an HTML
# `504 FUNCTION_INVOCATION_TIMEOUT` that the frontend's `res.json()` cannot parse —
# which is exactly how a backend problem became an endlessly spinning UI.
# Raise vercel.json `maxDuration` AND this value together, on a plan that allows it.
FUNCTION_MAX_DURATION_MS=10000
# Held back to serialize and flush the response before the platform kills us.
RESPONSE_RESERVE_MS=500
# Held back for whoever is CALLING us. The BloodOra frontend renders its pages in
# its own Vercel function, on the SAME 10s limit, and it awaits this API before it
# can answer the browser. If this API spends the whole budget, the caller is
# killed mid-render and the platform answers the browser with an HTML
# `504 FUNCTION_INVOCATION_TIMEOUT` — a body no `res.json()` can parse, which is
# how a healthy backend still reaches the user as "Server crash" plus a spinner
# that never stops. So:
#
#   answerByMs = budgetMs - upstreamReserveMs     (10000 - 500 - 1500 = 8000)
#
# Every request deadline below is clamped to `answerByMs`, not to the whole
# budget. Capped at a third of the budget so the reserve can never starve the
# work it protects. Raise it only together with the caller's own maxDuration.
UPSTREAM_RESERVE_MS=1500

# ---- Deadlines (all milliseconds; 0 disables the individual bound) ----
# NONE of these are optional tuning knobs. @libsql/client implements no timeout of
# its own, so without them an unreachable database makes every request — including
# GET /api/health — hang forever instead of failing. See src/db/timeout.ts.
#
# In addition, no request may exceed the budget ABOVE, however many of these it
# uses: every one is re-clamped at call time to the time actually left in the
# current invocation (src/utils/deadline.ts). That is what stops ten individually
# bounded calls — or a loop of fifty SMTP sends — from adding up past 10s.
#
# Per single SQL statement / HTTP round trip to Turso.
DB_TIMEOUT_MS=5000
# Per batched group (one round trip carrying many statements or image blobs).
# Was 20000 — twice the invocation it was supposed to protect; now clamped.
DB_BATCH_TIMEOUT_MS=20000
# How long a request waits for the cold-start bootstrap before getting a 503.
DB_BOOTSTRAP_TIMEOUT_MS=8000
# The SELECT 1 liveness probe inside GET /api/health.
HEALTH_DB_TIMEOUT_MS=1500
# Session-store reads/writes. A stalled DB must log the caller out, not hang.
SESSION_TIMEOUT_MS=3000
# Outer failsafe on any single request. MUST fire before the platform does, so the
# client always receives this app's JSON envelope. Leave it UNSET to inherit the
# whole budget (recommended). Was 55000 — it could therefore never fire at all,
# which is why production returned Vercel's 504 instead of ours.
#REQUEST_TIMEOUT_MS=
# TOTAL budget for one AI interaction, covering every attempt and backoff — not a
# per-attempt timeout. Was 25000 x 2 attempts = 50.4s inside a 10s function, and
# was then still set to the WHOLE budget (9500) — which left nothing for the
# frontend function proxying the answer, so the browser got Vercel's 504 page
# instead of ours. Default 6000: two attempts plus the post-processing reserve,
# and it is clamped to `answerByMs` whatever you set. Raise it only if the caller
# can wait that long too.
AI_TIMEOUT_MS=6000
# Per SMTP PHASE (connection / greeting / socket). nodemailer applies all three
# sequentially, so this is clamped to budget/3; smtp.service.ts also bounds each
# send as a whole.
SMTP_TIMEOUT_MS=8000
# How long an SSE stream holds its function open before ending itself gracefully
# (the frontend reconnects or falls back to polling). Keep below maxDuration.
SSE_MAX_MS=9000

# ---- Database circuit breaker ----
# While Turso is unreachable, every request would otherwise pay the FULL
# DB_TIMEOUT_MS before answering 503: measured at 5006ms per statement on a
# silent database. Ten visitors means ten 5-second functions, all failing. The
# breaker fails fast instead — after this many CONSECUTIVE transport failures it
# refuses new work immediately with a 503 plus `Retry-After`, and lets exactly one
# trial through per cooldown window to notice recovery. It never needs a redeploy
# to close again, and it ignores SQL errors entirely (a constraint violation is
# not an outage). See src/db/breaker.ts.
DB_BREAKER_THRESHOLD=3
# First cooldown window in ms; doubles per failed trial up to DB_BREAKER_MAX_COOLDOWN_MS.
DB_BREAKER_COOLDOWN_MS=2000
DB_BREAKER_MAX_COOLDOWN_MS=10000

# ---- Uploads ----
# Max size of a single image upload, in MB (multer fileSize limit).
# Keep this at or below 4: Vercel caps function request bodies at 4.5 MB, and
# staying under it means an oversized image gets our JSON error (400
# UPLOAD_ERROR) instead of the platform's 413 page.
MAX_UPLOAD_MB=4

# ---- Super admin provisioning (idempotent) ----
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=+8801000000000

# ---- AI (Groq, OpenAI-compatible). The admin panel can override all of these. ----
# WARNING — precedence trap: `ai_base_url`, `ai_model` and `ai_provider` are also
# SEEDED into the `settings` table, and getConfig() prefers the STORED value over
# these variables. On any database that has already been bootstrapped, changing
# AI_BASE_URL here (or in Vercel) has NO effect; change it in Admin → AI Assistant
# instead. This matters for the timeout budget: a stored base URL pointing at an
# unreachable host is a slow request, and only AI_TIMEOUT_MS stands between it and
# the function limit.
GROQ_API_KEY=
AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.6-27b
AI_BASE_URL=https://api.groq.com/openai/v1

# ---- SMTP ----
# Precedence: these variables are the DEFAULT. As soon as an admin saves the
# Admin → SMTP & Email panel, the stored values win (an empty stored value falls
# back to the environment again). Mail is written to a durable outbox before any
# send attempt, so a host that is down delays mail instead of failing the
# operation that triggered it; `POST /api/admin/mail/flush` retries the queue.
SMTP_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=BloodOra
SMTP_FROM_EMAIL=no-reply@bloodora.site
