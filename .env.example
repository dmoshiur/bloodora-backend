# ==================== BloodOra BACKEND API - Environment Configuration ====================
# Copy to .env for local development.
# On Vercel: Project -> Settings -> Environment Variables (set these as PLAIN values).

# Local dev port (Vercel ignores this)
PORT=4000
NODE_ENV=development

# ---------- Connection to the FRONTEND (the other Vercel project) ----------
# The exact URL of your frontend deployment. Used for CORS.
# You can list several origins separated by commas.
# Example: FRONTEND_URL=https://bloodora.vercel.app,https://bloodora.site
FRONTEND_URL=http://localhost:3000

# ---------- JWT (auth tokens shared with the frontend via HTTP only) ----------
# Use a long random string. The frontend NEVER needs this secret.
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Turso Serverless Database ----------
# Get from https://turso.tech -> Create Database
TURSO_DATABASE_URL=libsql://your-db-yourname.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ---------- File upload limit ----------
MAX_UPLOAD_SIZE=16777216

# ---------- Super Admin (auto-provisioned on startup) ----------
# On first run (or when missing), a Super Admin account is created from these values.
# Leave SUPER_ADMIN_EMAIL empty to disable (then the first registered user becomes admin).
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@bloodora.com
SUPER_ADMIN_PASSWORD=change-me-strong-password
SUPER_ADMIN_PHONE=+8801700000000
