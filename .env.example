# ============================ BloodOra backend environment ============================
# NEVER put any of these values in the frontend repo. The frontend only ever talks
# to the public API origin and never sees Turso tokens, secrets or DB credentials.

# ---- Database (Turso / libSQL) — REQUIRED in production ----
# Remote URL:  libsql://bloodora.xxxxx.eu-central-1.aws.data.turso.io
# Local dev:   leave unset (uses ./data/local.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Auth ----
# Long random string (e.g. `openssl rand -hex 32`). REQUIRED in production.
JWT_SECRET=change-me-64-hex
# 7 = days
JWT_TTL_DAYS=7
COOKIE_DOMAIN=
# Secure cookies are forced on when NODE_ENV=production or COOKIE_SECURE=1.
COOKIE_SECURE=

# ---- CORS / frontend ----
# Comma-separated allow-list of frontend origins, e.g.
# https://lspk.vercel.app,https://lspk-production.vercel.app
# Every listed origin may call the API with credentials. The FIRST one is also
# used as the base for links inside outgoing mail (password reset, email
# verification) — put the canonical public origin first.
FRONTEND_URL=http://localhost:3000

# ---- Environment ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- Uploads ----
# Max size of a single image upload, in MB (multer fileSize limit).
# Keep this at or below 4: Vercel caps function request bodies at 4.5 MB, and
# staying under it means an oversized image gets our JSON error (400
# UPLOAD_ERROR) instead of the platform's 413 page.
MAX_UPLOAD_MB=4

# ---- Super admin provisioning (idempotent) ----
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=+8801000000000

# ---- AI (Groq, OpenAI-compatible). The admin panel can override all of these. ----
GROQ_API_KEY=
AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.6-27b
AI_BASE_URL=https://api.groq.com/openai/v1

# ---- SMTP ----
# Precedence: these variables are the DEFAULT. As soon as an admin saves the
# Admin → SMTP & Email panel, the stored values win (an empty stored value falls
# back to the environment again). Mail is written to a durable outbox before any
# send attempt, so a host that is down delays mail instead of failing the
# operation that triggered it; `POST /api/admin/mail/flush` retries the queue.
SMTP_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=BloodOra
SMTP_FROM_EMAIL=no-reply@bloodora.site
